<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Download <%= title %> in high-quality MP3 format. Listen to this amazing track before downloading and explore similar songs on our music platform.">
    <meta name="keywords" content="<%= title %>, MP3 download, free music, audio streaming, music platform, download songs">
    <meta name="author" content="YTOMP3">
    <title>Download <%= title %> MP3 - High Quality Music | YTOMP3</title>
    
    <!-- Schema.org markup for Google -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MusicRecording",
      "name": "<%= title %>",
      "description": "<%= description %>",
      "url": "https://yourdomain.com/<%= downloadUrl %>",
      "genre": "Music",
      "audio": {
        "@type": "AudioObject",
        "contentUrl": "https://yourdomain.com/<%= downloadUrl %>",
        "encodingFormat": "audio/mpeg"
      }
    }
    </script>
 
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f0f0f0;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            line-height: 1.6;
        }

        .song-container {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            text-align: center;
            color: #333;
            max-width: 600px;
            width: 100%;
            margin: 20px;
        }

        .song-title {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 10px;
            color: #125382;
        }

        .song-description {
            font-size: 16px;
            margin-top: 20px;
            color: #555;
        }

        .custom-audio-player {
            margin-top: 20px;
            text-align: center;
        }

        audio {
            width: 100%;
            margin-top: 10px;
        }

        .audio-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 10px;
        }

        button {
            background-color: #125382;
            color: #fff;
            border: none;
            padding: 10px 20px;
            margin: 0 10px;
            cursor: pointer;
            transition: background-color 0.3s;
            border-radius: 5px;
        }

        button:hover {
            background-color: #1C2833;
        }

        input[type="range"] {
            width: 100px;
        }

        .download-link,
        .search-again-link {
            display: inline-block;
            background-color: #125382;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 10px 20px;
            font-size: 18px;
            margin-top: 20px;
            text-decoration: none;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .download-link:hover,
        .search-again-link:hover {
            background-color: #1C2833;
        }

        #download-status {
            margin-top: 10px;
            font-weight: bold;
            color: #125382;
        }

        .keywords {
            margin-top: 20px;
            font-style: italic;
            color: #555;
            font-size: 14px;
        }
        
        .breadcrumb {
            align-self: flex-start;
            margin: 10px 0 0 20px;
            font-size: 14px;
        }
        
        .breadcrumb a {
            color: #125382;
            text-decoration: none;
        }
        
        .breadcrumb a:hover {
            text-decoration: underline;
        }
        
        .seo-content {
            max-width: 600px;
            margin: 20px;
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        
        .seo-content h2 {
            color: #125382;
            margin-top: 0;
        }
        
        .seo-content p {
            color: #555;
        }
        
        .show {
          font-family: 'Arial', sans-serif;
          background-color: #f4f4f4;
          margin: 10px;
          padding: 0;
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
        }
        
        .song-container-show {
          width: 200px;
          margin: 10px;
          background-color: #fff;
          box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
          border-radius: 8px;
          overflow: hidden;
          transition: transform 0.2s ease-in-out;
          cursor: pointer;
          position: relative;
        }
        
        .song-container-show:hover {
          transform: scale(1.05);
        }
        
        .song-thumbnail-show {
          width: 100%;
          height: 150px;
          object-fit: cover;
        }
        
        .song-info-show {
          padding: 10px;
        }
        
        .song-title-show {
          font-weight: bold;
          margin-bottom: 5px;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          width: 100%;
        }
        
        .song-container-show:hover .song-title-show {
          white-space: normal;
          overflow: visible;
          text-overflow: unset;
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          background-color: #fff;
          padding: 10px;
          border-radius: 8px;
          box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        
        .song-description-show {
          font-size: 12px;
          color: #777;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          width: 100%;
          transition: all 0.3s ease-in-out;
        }
        
        .song-container-show:hover .song-description-show {
          white-space: normal;
          overflow: visible;
          text-overflow: unset;
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          background-color: rgba(255, 255, 255, 0.8);
          padding: 10px;
          border-radius: 0 0 8px 8px;
        }
        
        .song-container-show .song-description-show a {
          text-decoration: none;
          color: inherit;
        }
    </style>
</head>
<body>
    <!-- Breadcrumb navigation for better SEO -->
    <div class="breadcrumb">
        <a href="/">Home</a> &gt; <a href="/audio/search">Search</a> &gt; <span><%= title %></span>
    </div>
    
    <div class="song-container">
        <h1 class="song-title"><%= title %></h1>
        <div class="song-description"><%= description %></div>
        
        <div class="custom-audio-player">
            <audio id="custom-audio" preload="none">
                <source src="/<%= downloadUrl %>" type="audio/mpeg">
                Your browser does not support the audio element.
            </audio>
            <div class="audio-controls">
                <button id="play-pause-button" class="play">Play Song</button>
                <label for="volume-slider">Volume:</label>
                <input type="range" id="volume-slider" min="0" max="1" step="0.01" value="1">
            </div>
        </div>

        <a class="download-link" href="/<%= downloadUrl %>" download="<%= title %>.mp3">Download MP3</a>
        <a class="search-again-link" href="/audio/search">Search More Music</a>
        <h4 id="download-status"></h4>
        
        <div class="keywords">
            Related keywords: <%= title %> MP3 download, free music download, high quality audio, online music platform
        </div>
    </div>
    
    <!-- SEO Content Section -->
    <div class="seo-content">
        <h2>About This Song</h2>
        <p>Enjoy "<%= title %>" in high-quality MP3 format. Our platform provides free music downloads while ensuring excellent audio quality for your listening pleasure.</p>
        
        <h2>How to Download</h2>
        <p>Simply click the "Download MP3" button above to save "<%= title %>" directly to your device. The download will start immediately, and you'll be able to enjoy this track offline anytime.</p>
        
        <h2>Music Quality</h2>
        <p>All songs on our platform, including "<%= title %>", are available in high-quality MP3 format, ensuring you get the best listening experience whether you're using headphones, speakers, or in-car audio systems.</p>
        
        <h2>Legal Notice</h2>
        <p>Please ensure you have the right to download and use this content according to applicable copyright laws in your region. Our platform respects intellectual property rights and encourages users to support artists by purchasing their music when possible.</p>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelector(".download-link").onclick = () => { 
                document.querySelector("#download-status").textContent = "Download started - enjoy your music!";
            }
            
            const audio = document.getElementById("custom-audio");
            const playPauseButton = document.getElementById("play-pause-button");
            const volumeSlider = document.getElementById("volume-slider");

            playPauseButton.addEventListener("click", function () {
                if (audio.paused) {
                    audio.play();
                    playPauseButton.innerText = "Pause Song";
                } else {
                    audio.pause();
                    playPauseButton.innerText = "Play Song";
                }
            });

            volumeSlider.addEventListener("input", function () {
                audio.volume = volumeSlider.value;
            });

            const searchAgainLink = document.querySelector(".search-again-link");
            searchAgainLink.addEventListener("click", function (event) {
                event.preventDefault();
                window.location.href = searchAgainLink.getAttribute("href");
            });
        });
    </script>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4XM5Y83MEG"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4XM5Y83MEG');
    </script>
    
    <script id="aclib" type="text/javascript" src="//acscdn.com/script/aclib.js"></script>
    <script type="text/javascript">
        aclib.runAutoTag({
            zoneId: 'mykzljvwmv',
        });
    </script>
</body>
</html>
